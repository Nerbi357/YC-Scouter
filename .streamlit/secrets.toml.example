# Copy to `.streamlit/secrets.toml` locally, OR paste into
# Streamlit Community Cloud → App → Settings → Secrets.
# NEVER commit the real file — it holds a private key. (.gitignore excludes it.)

# --- Google service-account JSON, expanded into TOML keys ---
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxx"
# Keep the literal \n escapes; TOML stores it as one line.
private_key = "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
client_email = "yc-radar@your-project-id.iam.gserviceaccount.com"
client_id = "1234567890"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/yc-radar%40your-project-id.iam.gserviceaccount.com"

# --- Which sheet to read/write ---
[gsheets]
# Either the full URL or just the spreadsheet ID:
spreadsheet = "https://docs.google.com/spreadsheets/d/PASTE_SHEET_ID_HERE/edit"
worksheet = "annotations"

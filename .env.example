# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required ONLY if you want AI idea/uniqueness/risk summaries (Haiku 4.5).
# Without it, the pipeline still runs; the AI columns are filled with a
# placeholder and no API calls (and no charges) are made.
ANTHROPIC_API_KEY=

# Optional overrides (sensible defaults exist in code):
# YC_RADAR_AI_MODEL=claude-haiku-4-5
# YC_RADAR_BATCH_YEARS=2024,2025,2026

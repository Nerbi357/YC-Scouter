# Copy to .env and fill in. .env is gitignored — never commit real keys.
# In GitHub Actions / Streamlit Cloud these live in Secrets, not in a file.

# AI provider keys (File 2). Provide the one for your chosen provider.
# Without a key, the pipeline still runs and the AI columns show a placeholder
# (no API calls, no charges).
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional dashboard overrides (sensible defaults exist in code):
# YC_SCOUTER_DATASET=data/yc_dataset_ai_2026-01-27.parquet   # force a specific file
# YC_SCOUTER_USERDATA=data/user_data.csv                     # local notes fallback
